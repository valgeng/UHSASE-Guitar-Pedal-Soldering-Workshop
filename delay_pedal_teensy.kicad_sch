  (text "KNOBS (B10K linear): TIME / FEEDBACK / VOLUME" (at 25.4 132.08 0) (effects (font (size 2 2) bold) (justify left bottom)) (uuid ca5df9b3-c751-4d05-8231-4aaad22b6126))
  (text "FOOTSWITCH (momentary SPST) + LED" (at 25.4 195.58 0) (effects (font (size 2 2) bold) (justify left bottom)) (uuid 316c968c-333c-4811-b2bc-b23286abf5e8))
  (text "MICROCONTROLLER / DSP" (at 170.18 38.1 0) (effects (font (size 2 2) bold) (justify left bottom)) (uuid c4c03e12-22c5-4bb9-a08e-dc1c822f9401))
  (text "AUDIO PATH" (at 274.32 38.1 0) (effects (font (size 2 2) bold) (justify left bottom)) (uuid 00512c3d-c0a7-41b2-a6c2-ccf90d7b68df))
  (text "TEENSY 4.0 + AUDIO ADAPTOR (REV D/D2) DIGITAL DELAY" (at 170.18 236.22 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid 582edd0e-6399-46b6-904a-5e3e5870f365))
  (text "A1 = female 1x14 sockets. Stack: PCB -> Audio Adaptor (long-tail stacking headers) -> Teensy 4.0 on top." (at 170.18 239.72 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid 377a4ce6-1cd7-4929-9b07-fd436115ac4c))
  (text "J4 is wired with 4 short wires to the Audio Adaptor pads: LINE IN L, GND, LINE OUT L, GND." (at 170.18 243.22 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid 6201b0e6-89f2-459c-ac15-cc923f91c65f))
  (text "Pins used: 16/A2 = TIME, 17/A3 = FEEDBACK, 22/A8 = VOLUME, 2 = footswitch (INPUT_PULLUP), 3 = LED." (at 170.18 246.72 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid fddedbbe-f3f5-4389-9e02-6b5bfa5455a2))
  (text "Pins 6,7,8,10-13,15,18-21,23 belong to the Audio Adaptor - leave them unconnected on this PCB." (at 170.18 250.22 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid 36f0e6b7-1d74-4551-b6a6-283a8e20cf3b))
  (text "Teensy VIN max 5.5 V -> U1 L7805 makes +5V from the 9V supply. Unplug 9V before plugging USB (or cut the VUSB-VIN pad)." (at 170.18 253.72 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid 8f2c6741-a15e-4ff0-a9dd-f53ee8afc572))

